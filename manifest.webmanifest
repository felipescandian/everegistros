{
  "name": "OVT Correção Interativa",
  "short_name": "OVT Correção",
  "description": "Correção interativa de registros OVT com marcadores, pontuação e áudio.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#02060d",
  "theme_color": "#02060d",
  "icons": [
    {
      "src": "ovt-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "ovt-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            ".pdf",
            ".pptx"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?filehandler=1",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ]
      }
    }
  ]
}